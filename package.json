{
  "name": "@discord-telegram-bridge/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that mirrors Discord messages into Telegram.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rexezuge-CloudflareWorkers/Discord-Telegram-Bridge.git"
  },
  "scripts": {
    "postinstall": "pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:god-files && pnpm run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:test && pnpm run typecheck:scripts",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:god-files": "tsx node_modules/@rexezuge/tooling/src/scripts/check-god-files.ts",
    "lint": "node scripts/lint-workspaces.mjs",
    "typegen": "wrangler types --config ./apps/bridge/wrangler.template.jsonc --env-interface CloudflareEnv",
    "prepare-config": "WRANGLER_TEMPLATE_PATH=apps/bridge/wrangler.template.jsonc tsx scripts/prepare-wrangler-config.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint:fix": "node scripts/lint-workspaces.mjs --fix"
  },
  "devDependencies": {
    "@rexezuge/errors": "1.9.2",
    "@rexezuge/http": "1.9.2",
    "@rexezuge/runtime": "1.9.2",
    "@rexezuge/shared": "1.9.2",
    "@rexezuge/tooling": "1.9.2",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.2.2"
}
